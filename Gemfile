source "https://rubygems.org"

# Pin to the current GitHub Pages release; the old cached lock pinned v170
# (jekyll 3.6.2 / kramdown 1.14), which fails to build on modern Ruby.
gem "github-pages", "~> 232", group: :jekyll_plugins
gem "jekyll-remote-theme"

# Gems removed from Ruby's default set (3.4+); keep them explicit so the
# build keeps working as the runner's Ruby advances.
gem "rexml"
gem "base64"
gem "bigdecimal"
